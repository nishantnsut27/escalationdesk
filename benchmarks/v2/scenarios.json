      ],
      "relationships": [
        "shared_trace"
      ],
      "hypotheses": [
        "throttling",
        "timeout",
        "authentication"
      ],
      "expected_result": "Identify the observed rate-limit response",
      "should_abstain": false,
      "variants": [
        "complete",
        "missing_discriminating_evidence",
        "irrelevant_or_conflicting_context"
      ]
    },
    {
      "id": "deployment",
