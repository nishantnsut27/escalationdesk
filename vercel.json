{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "escalationdesk.vercel.app"
        }
      ],
      "headers": {
        "Location": "https://tracedesk.nishantraj.me/$1"
      },
      "status": 308
    },
    {
      "src": "/api(?:/(.*))?",
      "dest": "https://api.tracedesk.nishantraj.me/api/$1",
      "headers": {
        "x-vercel-enable-rewrite-caching": "0"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(login|signup|demo-login|forgot|account|privacy|dashboard|collections|errors|investigations|incidents|connections|import|logs|demo|overview|history|evidence|imports)/?",
      "methods": [
        "GET",
        "HEAD"
      ],
      "dest": "/index.html"
    },
    {
      "src": "/(collections|investigations|incidents|demo|history|evidence)/[^/]+/?",
      "methods": [
        "GET",
        "HEAD"
      ],
      "dest": "/index.html"
    }
  ]
}
