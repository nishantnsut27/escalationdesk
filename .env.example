# TraceDesk backend configuration. Copy values to ignored backend/.env or the
# backend host's environment. Never put database/email/provider secrets in VITE_*.
# Process environment wins over root .env, then backend/.env. Remove blank root
# overrides when configuring the same variable in backend/.env.

# Required platform storage: Neon PostgreSQL, development project.
# Paste the Neon connection URL here. The backend strengthens sslmode=require to
# verify-full using trusted CAs. There is no SQLite fallback.
DESK_DATABASE_URL=
# Integration tests/operators require a DIFFERENT Neon project/endpoint.
# Tests create isolated schemas there; never use the working application target.
DESK_TEST_DATABASE_URL=
# Bounded psycopg pool: 1-10 connections per process; default 5.
DESK_DATABASE_POOL_MAX=5

# Optional: enables live Groq investigations. Keep this file free of real keys.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional explicit proxy for Groq. Empty means direct HTTPS with TLS verification.
# The backend does not inherit HTTP_PROXY/HTTPS_PROXY from its launching shell.
GROQ_PROXY_URL=
# Optional advisory Jev triage, billed through the configured OpenRouter account.
# Secrets may also be placed in backend/.env; the process/root .env take precedence.
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.14
JEV_PROXY_URL=
# Local defaults:
DESK_PORT=8020
DESK_DATA_DIR=data

# Optional Sentry public integration. All credentials stay on the backend.
# Frontend HTTPS origin only, with no path or trailing slash. Used by account
# email links and Sentry redirects. Blank means loopback development without mail.
# Vercel frontend: https://tracedesk.nishantraj.me
# Render API: https://api.tracedesk.nishantraj.me (not this variable).
DESK_PUBLIC_URL=https://tracedesk.nishantraj.me
DESK_API_URL=https://api.tracedesk.nishantraj.me
# Pin the same tested Python patch version on Render.
PYTHON_VERSION=3.14.6
SENTRY_APP_SLUG=
SENTRY_CLIENT_ID=
SENTRY_CLIENT_SECRET=
# Generate once with scripts/configure_sentry.py; retain outside the database.
DESK_CONNECTION_KEY=

# Resend account and incident email. Sender domain must be verified in Resend.
# Sender: TraceDesk <notifications@mail.tracedesk.nishantraj.me>
# Reply-to: yournishantraj@gmail.com. No purchased mailbox is required.
RESEND_API_KEY=
# Optional separate Fernet key for queued email encryption. If blank, a distinct
# email key is derived from DESK_CONNECTION_KEY. Retain the key outside Git/DB.
DESK_EMAIL_KEY=
# Resend webhook signing secret, beginning whsec_. Needed for delivery receipts,
# not sending. Account and incident receipt endpoint:
# https://api.tracedesk.nishantraj.me/api/email/webhook
# Events: email.sent, email.delivered, email.delivery_delayed, email.failed,
# email.bounced, email.complained. Local testing may use the active tunnel URL
# with /api/email/webhook. Disable open and click tracking for auth messages.
RESEND_WEBHOOK_SECRET=
# Phase 12 reuses these backend credentials and adds no frontend secrets.
# Keep the existing Sentry integration subscribed to Issue webhooks at
# https://api.tracedesk.nishantraj.me/api/connections/sentry/webhook.
# Enable automation per connection/project in TraceDesk, after deployment.
# Explicit opt-in for real reference-service telemetry; consumes Sentry allowance.
SENTRY_REFERENCE_ENABLED=0
SENTRY_GATEWAY_DSN=
SENTRY_ORDER_DSN=
SENTRY_PAYMENT_DSN=


# The normal workspace does not run reference services or expose fault controls.
DESK_ENABLE_LAB=0
# Separate, explicitly invoked telemetry test application only.
SENTRY_TEST_DSN=
